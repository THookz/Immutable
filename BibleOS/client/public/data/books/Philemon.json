    "verseId": "Philemon.1.10",
    "book": "Philemon",
    "chapter": 1,
    "verse": 10,
    "language": "greek",
    "text": "παρακαλῶ σε περὶ τοῦ ἐμοῦ τέκνου, ὃν ἐγέννησα ἐν τοῖς ⸀δεσμοῖς Ὀνήσιμον,",
    "wordAlignment": "[{\"position\":1,\"word\":\"παρακαλῶ\",\"lemma\":\"παρακαλέω\",\"morphology\":\"1PAI-S--\",\"pos\":\"V-\"},{\"position\":2,\"word\":\"σε\",\"lemma\":\"σύ\",\"morphology\":\"----AS--\",\"pos\":\"RP\"},{\"position\":3,\"word\":\"περὶ\",\"lemma\":\"περί\",\"morphology\":\"--------\",\"pos\":\"P-\"},{\"position\":4,\"word\":\"τοῦ\",\"lemma\":\"ὁ\",\"morphology\":\"----GSN-\",\"pos\":\"RA\"},{\"position\":5,\"word\":\"ἐμοῦ\",\"lemma\":\"ἐμός\",\"morphology\":\"----GSN-\",\"pos\":\"A-\"},{\"position\":6,\"word\":\"τέκνου,\",\"lemma\":\"τέκνον\",\"morphology\":\"----GSN-\",\"pos\":\"N-\"},{\"position\":7,\"word\":\"ὃν\",\"lemma\":\"ὅς\",\"morphology\":\"----ASM-\",\"pos\":\"RR\"},{\"position\":8,\"word\":\"ἐγέννησα\",\"lemma\":\"γεννάω\",\"morphology\":\"1AAI-S--\",\"pos\":\"V-\"},{\"position\":9,\"word\":\"ἐν\",\"lemma\":\"ἐν\",\"morphology\":\"--------\",\"pos\":\"P-\"},{\"position\":10,\"word\":\"τοῖς\",\"lemma\":\"ὁ\",\"morphology\":\"----DPM-\",\"pos\":\"RA\"},{\"position\":11,\"word\":\"⸀δεσμοῖς\",\"lemma\":\"δεσμός\",\"morphology\":\"----DPM-\",\"pos\":\"N-\"},{\"position\":12,\"word\":\"Ὀνήσιμον,\",\"lemma\":\"Ὀνήσιμος\",\"morphology\":\"----ASM-\",\"pos\":\"N-\"}]",
