  {
    "id": 108903,
    "verseId": "Philemon.1.11",
    "book": "Philemon",
    "chapter": 1,
    "verse": 11,
    "language": "greek",
    "text": "τόν ποτέ σοι ἄχρηστον νυνὶ ⸀δὲ σοὶ καὶ ἐμοὶ εὔχρηστον,",
